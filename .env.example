# ============================================================
#  Ethics Critic — API Keys Configuration
#  1. Copy this file and rename it to:  .env
#  2. Fill in the keys for the providers you want to use.
#  3. Hugging Face Access Tokens can be generated for free at:
#     https://huggingface.co/settings/tokens
# ============================================================

# --- Hugging Face Inference API (Primary Core Framework Engine) ---
# Get your token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your-huggingface-token-here
HUGGINGFACE_MODEL=meta-llama/Llama-3.2-3B-Instruct

# --- OpenAI (Optional) ---
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (Optional) ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- Google Gemini (Optional) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# --- Server ---
PORT=3000
